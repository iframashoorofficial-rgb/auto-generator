# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model OpenRouter serves. Cheaper alternatives:
#   anthropic/claude-haiku-4.5
#   openai/gpt-4o-mini
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Used only for OpenRouter's dashboard attribution.
OPENROUTER_SITE_URL=http://localhost:3000

# Optional. Real stock footage and stills for the Discover deck.
# Free key at https://www.pexels.com/api/ — the Pexels licence permits
# commercial reuse. Without it, cards fall back to the bundled photography.
PEXELS_API_KEY=
